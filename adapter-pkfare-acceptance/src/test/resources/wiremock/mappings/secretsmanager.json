{
  "mappings": [
    {
      "request": {
        "urlPath": "/",
        "method": "POST",
        "headers": {
          "X-Amz-Target": {
            "equalTo": "secretsmanager.GetSecretValue"
          }
        },
        "bodyPatterns": [
          {
            "matchesJsonPath": "$[?(@.SecretId == 'acceptance/adapter-pkfare/entry-gate')]"
          }
        ]
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "ARN": "arn:aws:secretsmanager:ap-south-1:000000000000:secret:acceptance/adapter-pkfare/entry-gate",
          "Name": "acceptance/adapter-pkfare/entry-gate",
          "VersionId": "acceptance",
          "SecretString": "{\"username\":\"acceptance-client\",\"password\":\"acceptance-secret\"}"
        },
        "headers": {
          "Content-Type": "application/x-amz-json-1.1"
        }
      }
    }
  ]
}
