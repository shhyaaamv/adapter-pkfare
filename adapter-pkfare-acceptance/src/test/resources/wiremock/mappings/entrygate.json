{
  "mappings": [
    {
      "request": {
        "urlPath": "/oauth2/token",
        "method": "POST",
        "headers": {
          "Authorization": {
            "matches": "Basic .+"
          },
          "Content-Type": {
            "contains": "application/x-www-form-urlencoded"
          }
        },
        "formParameters": {
          "grant_type": {
            "equalTo": "client_credentials"
          },
          "scope": {
            "equalTo": "api"
          }
        }
      },
      "response": {
        "status": 200,
        "jsonBody": {
          "access_token": "acceptance-token",
          "token_type": "Bearer",
          "expires_in": 3600,
          "scope": "api"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    {
      "request": {
        "urlPath": "/entrygate/rest/request",
        "method": "POST",
        "headers": {
          "Authorization": {
            "equalTo": "Bearer acceptance-token"
          },
          "Service": {
            "equalTo": "AirShopping"
          },
          "Content-Type": {
            "equalTo": "application/json"
          }
        }
      },
      "response": {
        "status": 200,
        "bodyFileName": "entrygate/airshopping_rs.json",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    }
  ]
}
